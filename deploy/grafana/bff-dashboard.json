{
  "title": "BFF 生产总览",
  "uid": "bff-overview",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["bff"],
  "templating": {
    "list": [
      {
        "name": "path",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(bff_http_requests_total, path)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "请求速率（按状态类）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (status) (rate(bff_http_requests_total{path=~\"$path\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "请求延迟 P50/P95/P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(bff_http_request_duration_seconds_bucket{path=~\"$path\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bff_http_request_duration_seconds_bucket{path=~\"$path\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(bff_http_request_duration_seconds_bucket{path=~\"$path\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx 错误率",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(bff_http_requests_total{status=~\"5..\",path=~\"$path\"}[5m])) / clamp_min(sum(rate(bff_http_requests_total{path=~\"$path\"}[5m])), 0.001)"
        }
      ]
    },
    {
      "id": 4,
      "title": "登录 / 刷新速率",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(bff_oidc_login_total[5m]))", "legendFormat": "login (含失败尝试上限)" },
        { "expr": "sum(rate(bff_oidc_refresh_total[5m]))", "legendFormat": "refresh" }
      ]
    },
    {
      "id": 5,
      "title": "认证限流 429 / 锁竞争",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(bff_iprl_blocked_total[5m]))", "legendFormat": "blocked" },
        { "expr": "sum(rate(bff_iprl_lock_contention_total[5m]))", "legendFormat": "lock contention" }
      ]
    },
    {
      "id": 6,
      "title": "上游延迟 P95（按 upstream）",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (upstream, le) (rate(bff_upstream_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{upstream}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "熔断打开 / 半开探针",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(bff_circuit_breaker_open_total[5m]))", "legendFormat": "open" },
        { "expr": "sum(rate(bff_circuit_breaker_probe_total[5m]))", "legendFormat": "probe" }
      ]
    },
    {
      "id": 8,
      "title": "代理错误 / 熔断拒绝",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(bff_proxy_error_total[5m]))", "legendFormat": "proxy error" },
        { "expr": "sum(rate(bff_proxy_rejected_total[5m]))", "legendFormat": "breaker rejected" }
      ]
    },
    {
      "id": 9,
      "title": "Token Exchange 结果分布",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (result) (rate(bff_token_exchange_total[5m]))", "legendFormat": "{{result}}" }
      ]
    },
    {
      "id": 10,
      "title": "编排缓存命中 / 时长 P95",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum(rate(bff_pipeline_cache_hit_total[5m]))", "legendFormat": "cache hit" },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(bff_pipeline_duration_seconds_bucket[5m])))",
          "legendFormat": "pipeline p95"
        }
      ]
    }
  ],
  "__inputs": [],
  "__requires": []
}
